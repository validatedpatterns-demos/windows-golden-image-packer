# Copy to quay.env (gitignored) and set your Quay organizations/repos.
# cp example.quay.env quay.env
#
# Log in before pushing:
#   podman login quay.io
#
# One image per Windows version (used when the qcow2 filename contains 2022 or 2025):
QUAY_IMAGE_2022=quay.io/your-org/windows-server-2022-standard:golden
QUAY_IMAGE_2025=quay.io/your-org/windows-server-2025-standard:golden
#
# Optional: push the same disk to multiple repositories/tags (overrides version-specific vars):
# QUAY_IMAGE_REFS="quay.io/your-org/windows-2022:golden quay.io/your-org/windows-2022:1.0.0"
